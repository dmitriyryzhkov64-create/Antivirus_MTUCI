[
    uuid(8F7B5A3D-72A8-4B1A-9C3D-1E7C9D7D21A1),
    version(1.0),
    pointer_default(unique)
]
interface AntivirusRpc
{
    void RpcStopService([in] handle_t binding);

    int RpcGetCurrentUser(
        [in] handle_t binding,
        [out] int* isAuthenticated,
        [out, string] wchar_t** username
    );

    int RpcLogin(
        [in] handle_t binding,
        [in, string] const wchar_t* login,
        [in, string] const wchar_t* password
    );

    int RpcLogout([in] handle_t binding);

    int RpcGetLicenseInfo(
        [in] handle_t binding,
        [out] int* hasLicense,
        [out] hyper* expiresAtUnix
    );

    int RpcActivateProduct(
        [in] handle_t binding,
        [in, string] const wchar_t* activationCode
    );

    int RpcGetAvDatabaseInfo(
        [in] handle_t binding,
        [out] int* isLoaded,
        [out] hyper* recordCount,
        [out, string] wchar_t** releaseDate
    );

    int RpcScanFile(
        [in] handle_t binding,
        [in, string] const wchar_t* filePath,
        [out] int* isMalicious,
        [out] hyper* scannedFiles,
        [out] hyper* detectedThreats,
        [out, string] wchar_t** threatName
    );

    int RpcScanDirectory(
        [in] handle_t binding,
        [in, string] const wchar_t* directoryPath,
        [out] int* isMalicious,
        [out] hyper* scannedFiles,
        [out] hyper* detectedThreats,
        [out, string] wchar_t** threatName
    );
}